{
    "name": "diego182/mobile-detect",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Diego Mendonça",
            "email": "diego182@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "mobiledetect/mobiledetectlib": "^4.8",
        "symfony/dependency-injection": "^7.0|^8.0",
        "symfony/config": "^7.0|^8.0",
        "symfony/http-kernel": "^7.0|^8.0"
    },
    "require-dev": {
        "symfony/phpunit-bridge": "^7.0|^8.0"
